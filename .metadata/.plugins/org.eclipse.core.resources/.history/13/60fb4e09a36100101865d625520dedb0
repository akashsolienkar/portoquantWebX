garch:
  omega: 0.00001
  alpha: 0.1
  beta: 0.85

monte-carlo-simulator:
  steps: 257
  confidenceLevel: 0.95
  timeHorizon: 1.0

vintage:
  api:
    url: https://www.alphavantage.co
    key: demo

jwt:
  secret: mysecretkeymysecretkeymysecretkey123456  # at least 32 chars (256-bit)
  expiration-ms: 86400000  # 24 hours

logging:
  level:
    org.springframework.web: DEBUG

spring:
  thymeleaf:
    prefix: classpath:/templates/reports/
    suffix: .html
    mode: HTML
    encoding: UTF-8
  cache:
    type: redis
  redis:
    host: localhost
    port: 6379
    scheduler:
    frequency-sync-cron: "0 30 6 * * *"  # Every day at 6:30 AM


  datasource:
    url: jdbc:postgresql://localhost:5432/mydatabase
    username: postgres
    password: your_password
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    database-platform: org.hibernate.dialect.PostgreSQLDialect


management:
  endpoints:
    web:
      exposure:
        include: "health,info"
  endpoint:
    health:
      show-details: always


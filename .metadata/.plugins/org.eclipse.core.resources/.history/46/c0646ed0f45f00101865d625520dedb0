package com.quant.portoquant.infrastructure.historicaldata.provider;

package com.quant.portoquant.infrastructure.historicaldata.provider;

import com.quant.portoquant.domain.model.Asset;
import com.quant.portoquant.infrastructure.historicaldata.models.*;
import com.quant.portoquant.infrastructure.historicaldata.repository.HistoricalPriceRepository;
import com.quant.portoquant.infrastructure.repository.AssetRepository;
import jakarta.transaction.Transactional;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Component;

import java.util.*;

@Component
@RequiredArgsConstructor
public class HistoricalDataSaver {

    private final HistoricalPriceRepository historicalPriceRepository;
    private final AssetRepository assetRepository;

    @Transactional
    public void saveRollingData(String symbol, List<HistoricalPriceDto> rawPrices) {
        Asset asset = assetRepository.findByTicker(symbol)
                .orElseThrow(() -> new RuntimeException("Asset not found"));

        // Sort and limit to last 257
        List<HistoricalPriceDto> prices = rawPrices.stream()
                .sorted(Comparator.comparing(HistoricalPriceDto::date))
                .skip(Math.max(0, rawPrices.size() - 257))
                .toList();

        // Delete old data
        historicalPriceRepository.deleteByAssetId(asset.getId());

        // Save new data with tradingDayIndex
        List<HistoricalPrice> entities = new ArrayList<>();
        for (int i = 0; i < prices.size(); i++) {
            HistoricalPriceDto dto = prices.get(i);
            entities.add(HistoricalPrice.builder()
                    .asset(asset)
                    .price(dto.price())
                    .tradingDate(dto.date())
                    .tradingDayIndex(i + 1)
                    .build());
        }

        historicalPriceRepository.saveAll(entities);
    }
}

package com.quant.portoquant.infrastructure.repository;

import com.quant.portoquant.domain.model.Asset;
import com.quant.portoquant.infrastructure.historicaldata.models.HistoricalPrice;
import org.springframework.data.jpa.repository.*;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import java.util.List;

@Repository
public interface HistoricalPriceRepository extends JpaRepository<HistoricalPrice, UUID> {

    List<HistoricalPrice> findByAssetOrderByTradingDayIndex(Asset asset);

    @Modifying
    @Query("DELETE FROM HistoricalPrice p WHERE p.asset.id = :assetId")
    void deleteByAssetId(@Param("assetId") Long assetId);

    @Modifying
    @Query("DELETE FROM HistoricalPrice p WHERE p.asset.id = :assetId AND p.tradingDayIndex = 1")
    void deleteOldest(@Param("assetId") Long assetId);

    @Modifying
    @Query("UPDATE HistoricalPrice p SET p.tradingDayIndex = p.tradingDayIndex - 1 " +
           "WHERE p.asset.id = :assetId AND p.tradingDayIndex > 1")
    void shiftIndices(@Param("assetId") Long assetId);
}

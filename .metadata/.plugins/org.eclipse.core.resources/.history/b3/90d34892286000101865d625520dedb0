package com.quant.portoquant.infrastructure.historicaldata.scheduler;

package com.quant.portoquant.infrastructure.scheduler;

import com.quant.portoquant.domain.model.enums.AssetType;
import com.quant.portoquant.infrastructure.historicaldata.models.HistoricalDataMeta;
import com.quant.portoquant.infrastructure.historicaldata.rolling.RollingWindowManager;
import com.quant.portoquant.infrastructure.historicaldata.registry.HistoricalDataSourceRegistry;
import com.quant.portoquant.infrastructure.historicaldata.provider.HistoricalDataProvider;
import com.quant.portoquant.infrastructure.repository.HistoricalDataMetaRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import java.util.List;

@Component
@RequiredArgsConstructor
@Slf4j
public class HistoricalDataRollingScheduler {

    private final HistoricalDataMetaRepository metaRepository;
    private final HistoricalDataSourceRegistry providerRegistry;
    private final RollingWindowManager rollingWindowManager;

    /**
     * Scheduled to run every weekday at 6:00 PM IST (after market closes).
     * Cron format: second, minute, hour, day of month, month, day(s) of week
     * "0 0 18 * * MON-FRI" = 6 PM, Monday to Friday
     */
    @Scheduled(cron = "0 0 18 * * MON-FRI", zone = "Asia/Kolkata")
    public void runRollingUpdateForAllAssets() {
        log.info("Starting scheduled rolling update job...");

        List<HistoricalDataMeta> allAssets = metaRepository.findAll();

        for (HistoricalDataMeta meta : allAssets) {
            try {
                AssetType type = meta.getAsset();
                String ticker = meta.getName();

                HistoricalDataProvider provider = providerRegistry.getProvider(type);
                List<Double> latestPrices = provider.fetchLatestRollingPrices(ticker, meta.getFrequency());

                if (!latestPrices.isEmpty()) {
                    rollingWindowManager.applyRollingUpdate(meta, latestPrices);
                    log.info("Updated rolling data for {}", ticker);
                }
            } catch (Exception e) {
                log.error("Failed rolling update for asset: " + meta.getName(), e);
            }
        }

        log.info("Rolling update job completed.");
    }
}
